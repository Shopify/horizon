    },
    {
      "type": "range",
      "id": "d_nudge_y",
      "label": "t:settings.r_story_nudge_y",
      "min": -100,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "d_scale",
      "label": "t:settings.r_story_scale",
      "min": 90,
      "max": 115,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
