  "platform_customizations": {
    "custom_css": [
      "sticky-add-to-cart > * {font-size: 0.7em;}",
      ".button {font-weight: bold;}",
      "body,.paragraph:not(.button),.paragraph > *:not(.paragraph.menu__item > *),.text-block.paragraph :is(h1, h2, h3, h4, h5, h6) {--font-paragraph--size: clamp(1.09375rem, 2.5vw, 1.5625rem);}",
      ":root {--narrow-page-width: 1000px;}",
      ".button {font-weight: 500;}",
      ".product-card .rating-wrapper {flex-direction: column; align-items: unset; gap: var(--gap-3xs);}",
      ".rating {--star-size: 1rem !important;}",
      "summary .svg-wrapper {height: var(--icon-size-lg); width: var(--icon-size-lg);}",
      "lite-vimeo-combustion {border-radius: 1rem; overflow: hidden;}",
      "div.shopify-block:has(.cbi-lite-vimeo) {width: 100%;}",
      "variant-picker {font-size: var(--font-size--xs);}",
      "product-card .quick-add__button {opacity: 1;}",
      ".quick-add__button:not(:hover) {border-color: currentColor;}",
      ".quick-add__button .add-to-cart-text__content {grid-template-columns: 1fr; font-size: var(--font-size--sm);}",
      "quick-add-component:not(:is(.card-gallery > *)) {--quick-add-display: flex; --quick-add-mobile-display: flex; --quick-add-mobile-opacity: 1;}",
      ".filled-star {fill: var(--color-primary);}"
    ]
  }
}
