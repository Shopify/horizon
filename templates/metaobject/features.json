              ]
            },
            "accordion_row_KCDWbj": {
              "type": "_accordion-row",
              "disabled": true,
              "settings": {
                "heading": "Instructions for use",
                "open_by_default": false,
                "icon": "none",
                "width": 12
              },
              "blocks": {
                "text_WbVJTn": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p><strong>How to cook food that is safe and still delicious:</strong></p><ul><li>Turn on your CPT </li><li>Open the Combustion App</li><li>Where it says “Safeguard this cook with SafeCook” tap “Add” </li><li>Toggle on (the toggle will turn red)</li><li>Choose your meat type (the default is “Poultry”)</li><li>Choose the form that best describes your prep (for instance “intact cut” for a steak)</li><li>The app will automatically show you the minimum safe cooking temperature and the required food safety standard</li><li>Tap “apply”</li><li>This activates SafeCook</li><li><strong>When your food is safe, the app will display a green SafeCook badge</strong></li></ul>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
