          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<h2>Predictive Thermometer + Display + Booster</h2>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h2",
            "font": "var(--font-body--family)",
