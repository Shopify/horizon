            "text_MLhJRX": {
              "type": "text",
              "name": "t:names.text",
              "settings": {
                "text": "<h3>Instant Read Mode</h3>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "center",
                "type_preset": "h3",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
