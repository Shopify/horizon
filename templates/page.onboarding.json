            "text_jTbjKZ": {
              "type": "text",
              "name": "t:names.text",
              "settings": {
                "text": "<h3>Predictive Cooking (with Display)</h3>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "center",
                "type_preset": "h3",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
