                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_BpfMbN"
              ]
            },
            "accordion_row_wlWnQH": {
              "type": "_accordion-row",
              "settings": {
