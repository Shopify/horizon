              ]
            },
            "accordion_row_BVkjNt": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Poor range (smoker, grill, or sous vide)",
                "open_by_default": false,
                "icon": "none",
                "width": 12
              },
              "blocks": {
                "text_bLVzSe": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Move the first range extender (Booster or Display) as close as possible to the cooking apparatus.</p><p>If possible, establish a clear line-of-sight between MeatNet™ tools. </p><p>Common radio obstructions include metal, water, brick, reflective glass, and human beings. </p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "custom",
                    "font": "var(--font-body--family)",
