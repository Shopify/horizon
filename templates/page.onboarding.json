                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Overheated! Remove from heat immediately! </p><p>Lower sensors (below the min line) must be kept below 220ºF. Upper sensors must be kept below 570ºF. </p><p>Using the thermometer above these temps may damage your thermometer and will void the warranty.  </p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "custom",
