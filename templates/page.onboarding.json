          "blocks": {
            "accordion_row_SBDGgo": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Steak (in a pan) step-by-step",
                "open_by_default": false,
                "icon": "none",
                "width": 12
              },
              "blocks": {
                "text_nTMcym": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<ul><li>Get a steak (if you’re undecided, ribeyes are nice) </li><li>Let it rest on the counter for 10-15 min (optional, but it helps)</li><li>Pre-heat your pan - medium high (xº)</li><li>Season the steak (salt!)  </li><li>Remove the CPT from the charger (or Booster)</li><li>Insert the CPT across the grain, aiming for the thick part</li><li>Set your target temp on the Display by pressing +/- then start (Hint: 127ºF is a nice medium rare)</li><li>Or use the app - tap “predict” then enter the temp</li><li>Add oil (butter is ideal) to pan and put the steak on </li><li>Turn every two minutes </li><li>The Display (or app) will show a percent (%) until the prediction is resolved </li><li>Continue cooking (and flipping) and wait for the beep</li><li>Remove from heat</li><li>Slice immediately (no resting) in the same direction that the CPT was inserted (across the grain)</li><li>Enjoy your perfectly cooked steak!</li></ul>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "custom",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
