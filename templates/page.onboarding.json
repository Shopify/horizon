    "collapsible_juDXay": {
      "type": "section",
      "blocks": {
        "accordion_gthPZf": {
          "type": "accordion",
          "name": "t:names.accordion",
          "settings": {
            "icon": "plus",
            "dividers": false,
            "divider_color": "",
            "type_preset": "h4",
            "background_color": "",
            "text_color": "",
            "border": "none",
