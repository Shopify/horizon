    "collapsible_zkTzIH": {
      "type": "section",
      "blocks": {
        "text_faq_heading": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<h2>Frequently Asked Questions</h2>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
            "line_height": "normal",
            "letter_spacing": "normal",
